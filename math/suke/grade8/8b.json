      "tips": [
        {
          "id": "math-u9-01",
          "slot": "any",
          "tag": "定理",
          "text": "平行四边形性质：对边平行且相等、对角相等、对角线互相平分。"
        },
        {
          "id": "math-u9-02",
          "slot": "any",
          "tag": "定理",
          "text": "平行四边形判定五种，最常用：一组对边平行且相等 / 对角线互相平分。"
        },
        {
          "id": "math-u9-03",
          "slot": "any",
          "tag": "定理",
          "text": "矩形：四角直、对角线相等；菱形：四边等、对角线互相垂直且平分对角。"
        },
        {
          "id": "math-u9-04",
          "slot": "any",
          "tag": "公式",
          "text": "菱形面积=两条对角线乘积的一半：S=½ab。"
        },
        {
          "id": "math-u9-05",
          "slot": "any",
          "tag": "定理",
          "text": "三角形中位线：平行于第三边，且等于第三边的一半——见中点想中位线。"
        },
        {
          "id": "math-u9-06",
          "slot": "any",
          "tag": "易错",
          "text": "对角线相等→矩形；对角线互相垂直→菱形；又相等又垂直→正方形。"
        },
        {
          "id": "math-u9-07",
          "slot": "any",
          "tag": "方法",
          "text": "判定特殊四边形的标准路线：先证平行四边形，再加矩形/菱形条件。"
        },
        {
          "id": "math-u9-08",
          "slot": "any",
          "tag": "概念",
          "text": "平行四边形（含矩形菱形正方形）都是中心对称图形，对称中心是对角线交点。"
        }
      ]
    },
