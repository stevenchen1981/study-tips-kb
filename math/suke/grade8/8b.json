      "tips": [
        {
          "id": "math-u11-01",
          "slot": "any",
          "tag": "概念",
          "text": "反比例函数 y=k/x（k≠0），图象叫双曲线，两个分支不与坐标轴相交。"
        },
        {
          "id": "math-u11-02",
          "slot": "any",
          "tag": "定理",
          "text": "k>0：图象在一、三象限，每个象限内 y 随 x 增大而减小；k<0 相反。"
        },
        {
          "id": "math-u11-03",
          "slot": "any",
          "tag": "易错",
          "text": "单调性只说『每个象限内』——不能说整条双曲线上y随x增大而减小。"
        },
        {
          "id": "math-u11-04",
          "slot": "any",
          "tag": "公式",
          "text": "k 的几何意义：图象上任意一点向两轴作垂线，围成的矩形面积=|k|。"
        },
        {
          "id": "math-u11-05",
          "slot": "any",
          "tag": "方法",
          "text": "求解析式只需一个点：k=xy，代入该点坐标即可。"
        },
        {
          "id": "math-u11-06",
          "slot": "any",
          "tag": "题型",
          "text": "与一次函数比较大小：联立求交点，比大小看图象谁在上谁在下。"
        },
        {
          "id": "math-u11-07",
          "slot": "any",
          "tag": "公式",
          "text": "连结原点与图象上一点：三角形面积 = |k|/2（矩形面积 |k| 的一半）。"
        },
        {
          "id": "math-u11-08",
          "slot": "any",
          "tag": "易错",
          "text": "双曲线与坐标轴永不相交：因为 x≠0 且 y≠0，图象只能无限逼近坐标轴。"
        }
      ]
