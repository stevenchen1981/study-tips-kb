      "unit": 5,
      "title": "平面直角坐标系",
      "topic_cn": "坐标与对称、平移",
      "key_points": [
        "象限符号",
        "对称点坐标",
        "点到坐标轴的距离"
      ],
      "tips": [
        {
          "id": "math-u5-01",
          "slot": "any",
          "tag": "概念",
          "text": "坐标(x,y)：x在前y在后，横坐标x，纵坐标y，原点是(0,0)。"
        },
        {
          "id": "math-u5-02",
          "slot": "any",
          "tag": "易错",
          "text": "象限符号：一(+,+) 二(−,+) 三(−,−) 四(+,−)。坐标轴上的点不属于任何象限。"
        },
        {
          "id": "math-u5-03",
          "slot": "any",
          "tag": "公式",
          "text": "点P(a,b)：关于x轴对称(a,−b)，关于y轴对称(−a,b)，关于原点对称(−a,−b)。"
        },
        {
          "id": "math-u5-04",
          "slot": "any",
          "tag": "概念",
          "text": "x轴上的点纵坐标为0，y轴上的点横坐标为0。"
        },
        {
          "id": "math-u5-05",
          "slot": "any",
          "tag": "方法",
          "text": "平移口诀：左减右加（横），上加下减（纵）。"
        },
        {
          "id": "math-u5-06",
          "slot": "any",
          "tag": "题型",
          "text": "两点连线平行x轴 ⇔ 纵坐标相等；平行y轴 ⇔ 横坐标相等。"
        },
        {
          "id": "math-u5-07",
          "slot": "any",
          "tag": "易错",
          "text": "点P(a,b)到x轴的距离是|b|，到y轴的距离是|a|——别搞反。"
        },
        {
          "id": "math-u5-08",
          "slot": "any",
          "tag": "方法",
          "text": "一、三象限角平分线上点：横纵坐标相等；二、四象限角平分线上点：横纵坐标互为相反数。"
        }
      ]
    },
    {
      "unit": 6,
      "title": "一次函数",
      "topic_cn": "y=kx+b 的图象与性质",
      "key_points": [
        "k 定方向 b 定交点",
        "待定系数法",
        "与方程不等式的关系"
      ],
      "tips": [
        {
          "id": "math-u6-01",
          "slot": "any",
          "tag": "概念",
          "text": "一次函数 y=kx+b（k≠0）；b=0 时叫正比例函数 y=kx。"
        },
        {
          "id": "math-u6-02",
          "slot": "any",
          "tag": "定理",
          "text": "k 定方向：k>0 图象上升（y随x增大而增大）；k<0 下降。"
        },
        {
          "id": "math-u6-03",
          "slot": "any",
          "tag": "定理",
          "text": "b 定交点：图象与y轴交于(0,b)。b>0 交正半轴，b<0 交负半轴。"
        },
        {
          "id": "math-u6-04",
          "slot": "any",
          "tag": "方法",
          "text": "待定系数法：把两点坐标代入 y=kx+b 解出 k、b——求解析式的万能方法。"
        },
        {
          "id": "math-u6-05",
          "slot": "any",
          "tag": "定理",
          "text": "两直线平行 ⇔ k 相等（b 不等）。"
        },
        {
          "id": "math-u6-06",
          "slot": "any",
          "tag": "题型",
          "text": "kx+b>0 的解集 = 图象在x轴上方部分对应的x范围——数形结合看图说话。"
        },
        {
          "id": "math-u6-07",
          "slot": "any",
          "tag": "易错",
          "text": "求图象与坐标轴围成的三角形面积：先求与轴交点，用 ½×底×高。"
        },
        {
          "id": "math-u6-08",
          "slot": "any",
          "tag": "题型",
          "text": "行程图象题：先看横纵轴各表示什么，再看起点、拐点、交点（相遇/追上）。"
        }
      ]
    },
    {
      "unit": 7,
      "title": "数据的收集、整理、描述",
      "topic_cn": "统计基础与特征数",
      "key_points": [
        "普查与抽样",
        "平均数/中位数/众数",
        "方差"
      ],
      "tips": [
        {
          "id": "math-u7-01",
          "slot": "any",
          "tag": "概念",
          "text": "普查精确但费时费力；抽样调查省时，关键是样本要有代表性。"
        },
        {
          "id": "math-u7-02",
          "slot": "any",
          "tag": "易错",
          "text": "样本容量是一个数字，不带单位。"
        },
        {
          "id": "math-u7-03",
          "slot": "any",
          "tag": "概念",
          "text": "频率=频数÷总数；直方图中各组频数之和=数据总数。"
        },
        {
          "id": "math-u7-04",
          "slot": "any",
          "tag": "概念",
          "text": "中位数要先把数据排序：奇数个取正中间，偶数个取中间两个的平均。"
        },
        {
          "id": "math-u7-05",
          "slot": "any",
          "tag": "易错",
          "text": "众数是出现次数最多的数，可能不止一个；平均数受极端值影响，中位数不受。"
        },
        {
          "id": "math-u7-06",
          "slot": "any",
          "tag": "概念",
          "text": "方差越大，数据波动越大、越不稳定；比较稳定性就看方差（或标准差）。"
        },
        {
          "id": "math-u7-07",
          "slot": "any",
          "tag": "方法",
          "text": "扇形图看比例，条形图看数量，折线图看趋势——选图先想表达什么。"
        },
        {
          "id": "math-u7-08",
          "slot": "any",
          "tag": "方法",
          "text": "定组数：先算（最大值−最小值）÷组距，结果带小数时向上取整（进一法）。"
        }
      ]
    },
    {
      "unit": 8,
      "title": "认识概率",
      "topic_cn": "随机事件与等可能概率",
      "key_points": [
        "P(A)=m/n",
        "列表法与树状图"
      ],
      "tips": [
        {
          "id": "math-u8-01",
          "slot": "any",
          "tag": "概念",
          "text": "事件分三类：必然事件（P=1）、不可能事件（P=0）、随机事件（0<P<1）。"
        },
        {
          "id": "math-u8-02",
          "slot": "any",
          "tag": "公式",
          "text": "等可能条件下 P(A)=m/n：m 是事件A包含的结果数，n 是所有等可能结果数。"
        },
        {
          "id": "math-u8-03",
          "slot": "any",
          "tag": "易错",
          "text": "掷两枚硬币：正正、正反、反正、反反共4种等可能结果，一正一反的概率是2/4=1/2，不是1/3！"
        },
        {
          "id": "math-u8-04",
          "slot": "any",
          "tag": "方法",
          "text": "两步试验求概率：列表法或树状图法，关键是做到不重不漏。"
        },
        {
          "id": "math-u8-05",
          "slot": "any",
          "tag": "易错",
          "text": "用频率估计概率：试验次数越多频率越接近概率，但永远不完全相等。"
        },
        {
          "id": "math-u8-06",
          "slot": "any",
          "tag": "题型",
          "text": "转盘/摸球问题：先确认『等可能』，转盘面积不等时要按比例换算。"
        },
        {
          "id": "math-u8-07",
          "slot": "any",
          "tag": "易错",
          "text": "概率大≠一定发生：P=0.9 的事件也可能不发生，单次试验结果无法确定。"
        },
        {
          "id": "math-u8-08",
          "slot": "any",
          "tag": "概念",
          "text": "概率取值范围 0≤P(A)≤1：越接近 1 越可能发生，但不等于一定发生。"
        }
      ]
    },
